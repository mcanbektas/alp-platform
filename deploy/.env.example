# Bu dosyanın kopyası `.env` olarak açılır ve DEPOYA GİRMEZ (.gitignore'da).
#   cp .env.example .env
#
# Yerel yığın için POSTGRES_* ve JWT_KEY yeterlidir; gerisi varsayılana düşer.

# ---- Veritabanı ----
POSTGRES_DB=alp_pcb_toolkit
POSTGRES_USER=alp
# Üretimde rastgele üret:  openssl rand -base64 32
POSTGRES_PASSWORD=degistir

# ---- JWT ----
# HMAC-SHA256 için en az 32 BAYT gerekir; kısa anahtarla uygulama açılışta durur.
#   openssl rand -base64 48
JWT_KEY=degistir-en-az-32-bayt-olmali
JWT_ISSUER=alp-pcb-toolkit
JWT_AUDIENCE=alp-pcb-toolkit

# ---- Ağ ----
# Yerelde uygulamanın açılacağı port (http://localhost:8080).
# ÜRETİMDE 80 yapılır: prod örtüsü yalnızca 443'ü ekler, 80 buradan gelir.
WEB_PORT=8080
# Doğrulama ve parola sıfırlama bağlantıları bu adresten üretilir.
FRONTEND_BASE_URL=http://localhost:8080
# Sitenin genel adresi. DERLEME zamanında okunur (web imajının build arg'ı):
# sitemap.xml'deki URL'ler ile 76 sayfanın <head>'indeki canonical ve hreflang
# etiketleri MUTLAK adres ister, göreli yazılamaz. Boş bırakılırsa placeholder
# alan adı yazılır ve derleme uyarı basar — yerelde sorun değil, ÜRETİMDE
# doldurulması şart, yoksa arama motoruna var olmayan bir alan adı bildirilir.
# Değiştirildiğinde web imajı YENİDEN DERLENİR (`--build`), yeniden başlatmak
# yetmez.
VITE_SITE_URL=
# Compose ağının alt ağı. api'nin App__KnownProxyNetworks değeri buna eşittir —
# ikisi birlikte değişir, yoksa gerçek istemci IP'si görünmez.
PROXY_NETWORK=172.28.0.0/16

# ---- Yönetim ----
# Yönetim panelini (/yonetim) görebilecek hesapların e-postaları, virgülle
# ayrılır. Yetkinin TEK kaynağı budur: panelden, kayıttan ya da başka bir uçtan
# admin olunamaz — yetki vermek bu satırı değiştirip api'yi yeniden başlatmayı
# gerektirir. Listeden çıkarılan hesabın yetkisi açılışta geri alınır.
# Adres henüz kayıtlı değilse uyarı günlüğe düşer ve o hesap kayıt olduğu anda
# yetkiyi alır. Boş bırakılırsa panel kimseye açılmaz.
ADMIN_EMAILS=

# ---- Denetim izi ----
# İşlem güvenliği kayıtlarının (AuditEvents — kim ne yaptı) en çok kaç gün
# saklanacağı. AuditCleanupService bu sınırdan eski kaydı periyodik siler.
# Gizlilik ve KVKK sayfalarında beyan edilen süreyle AYNI kalmalı
# (web/src/data/legalText.js) — burayı değiştirirsen o metni de güncelle.
AUDIT_RETENTION_DAYS=365

# ---- SMTP ----
# Boş bırakılırsa postalar gönderilmez, yalnızca günlüğe yazılır.
# UYARI: e-posta doğrulaması zorunludur (SignIn.RequireConfirmedEmail).
# Üretimde SMTP kurulmazsa hiçbir kullanıcı giriş yapamaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ALP PCB Toolkit
# None | StartTls | SslOnConnect   (587 → StartTls, 465 → SslOnConnect)
SMTP_SECURITY=StartTls

# ---- Yalnızca üretim (docker-compose.prod.yml) ----
# Alan adı: TLS sertifikası ve nginx server_name bundan gelir.
APP_DOMAIN=ornek-alan-adi.com
# ghcr.io/<kullanıcı>/<depo> — GitHub Actions imajları buraya iter.
IMAGE_PREFIX=ghcr.io/mcanbektas/alp-pcb-toolkit
# Dağıtılacak sürüm. `latest` yerine commit sha'sı yazmak geri almayı
# tek satırlık iş yapar.
IMAGE_TAG=latest
# Let's Encrypt bildirimleri bu adrese gider.
CERTBOT_EMAIL=
