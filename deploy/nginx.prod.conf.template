# Üretim: TLS sonlandırma + SPA + /api ters vekili.
#
# Bu bir ŞABLONDUR. nginx imajının giriş noktası /etc/nginx/templates/ altındaki
# `.template` dosyalarını envsubst'tan geçirip /etc/nginx/conf.d/ altına yazar ve
# YALNIZCA ortamda tanımlı değişkenleri değiştirir — bu yüzden `$host`, `$uri`,
# `$remote_addr` gibi nginx değişkenleri olduğu gibi kalır, `${APP_DOMAIN}`
# değişir. Alan adını depodaki dosyaya yazmak yerine böyle geçmek, sunucuda
# `git pull` sırasında yerel değişiklik çakışması çıkmasını da önler.
#
# Gerekli: APP_DOMAIN ortam değişkeni ve /etc/letsencrypt altında geçerli sertifika.
# İlk sertifika alınmadan önce 443 bloğu açılamaz — sıra deploy/README.md'de.
#
# DİKKAT — nginx'te `add_header` MİRAS ALINMAZ (bkz. nginx.conf'taki aynı not).

# Kenar hız sınırı — gerekçe nginx.conf'taki aynı bloğun yorumunda.
# ($binary_remote_addr bir nginx değişkenidir; envsubst yalnızca ortamda
# tanımlı ${...} adlarını değiştirdiği için olduğu gibi kalır.)
limit_req_zone $binary_remote_addr zone=api_edge:10m rate=20r/s;

# Erişim günlüğünden SORGU DİZESİ düşürülür — gerekçe nginx.conf'taki aynı
# bloğun yorumunda: parola sıfırlama ve e-posta doğrulama token'ları sorguda
# taşınır ve varsayılan `combined` biçimi onları düz metin loglardı.
# (Buradaki adlar nginx değişkenidir; envsubst yalnızca ortamda tanımlı
# ${...} adlarını değiştirdiği için olduğu gibi kalırlar.)
map $request_uri $uri_sorgusuz {
    "~^(?<yol>[^?]*)" $yol;
    default           $request_uri;
}

log_format sorgusuz '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri_sorgusuz $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# ---- HTTP: yalnızca ACME ve yönlendirme ----
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    # 443'e yönlendirilen istek de sorgusuyla loglanırdı — token taşıyan bir
    # bağlantı http:// olarak açıldığında sızıntı burada olurdu.
    access_log /var/log/nginx/access.log sorgusuz;

    server_tokens off;

    # Let's Encrypt http-01 doğrulaması. Yönlendirmeden ÖNCE gelmeli, yoksa
    # doğrulama isteği de 301 yer ve sertifika yenilemesi sessizce durur.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Konteyner sağlık kontrolü düz HTTP'den gelir (web/Dockerfile,
    # http://127.0.0.1/healthz). Yalnızca 443 bloğunda olsaydı kontrol 301
    # alır ve busybox wget'in yönlendirmeyi izleyip sertifika uyumsuzluğunu
    # yutmasına bel bağlanırdı — burada doğrudan 200 döner.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS ----
server {
    # IPv6 de açık — konteyner içi sağlık kontrolü `localhost`u ::1'e çözer.
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    access_log /var/log/nginx/access.log sorgusuz;

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # TLS 1.2 için modern AEAD takımları; TLS 1.3 takımlarını nginx kendisi
    # yönetir, bu satırdan etkilenmez.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    # OCSP stapling: iptal durumunu sunucu iliştirir, tarayıcı ayrıca CA'ya
    # sormaz — hem gizlilik hem el sıkışma süresi.
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/${APP_DOMAIN}/chain.pem;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 12m;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/xml
        image/svg+xml;

    # HSTS yalnızca burada: TLS'siz yapılandırmada anlamsızdır ve alan adını
    # sertifika hazır olmadan HTTPS'e kilitlerdi.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP ve Permissions-Policy — gerekçe nginx.conf'taki aynı bloğun
    # yorumunda; iki dosya birebir aynı politikayı taşır.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- API ters vekili (nginx.conf ile birebir aynı) ----
    # Değişken + resolver: sabit yazıldığında nginx api'nin IP'sini açılışta bir
    # kez çözer ve saklar; api konteyneri yeniden yaratıldığında ölü adrese
    # vekiller. Ayrıntı nginx.conf'taki aynı bloğun yorumunda.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        limit_req zone=api_edge burst=40 nodelay;
        limit_req_status 429;

        set $api_upstream http://api:8080;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        proxy_buffering off;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        try_files $uri =404;
    }

    # Yazı tipleri: dosya adı içeriğiyle sabittir, aşağıdaki no-store bunlara
    # uygulanmamalı. Gerekçe nginx.conf'taki nottadır.
    location /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        try_files $uri =404;
    }

    # Web app manifest'i — ayrı blokta olmasının tek nedeni içerik tipi
    # (`.webmanifest` mime.types'ta yok). Gerekçe nginx.conf'ta.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        try_files $uri =404;
    }

    # HTML kabukları + SPA geri düşüşü. `no-store` burada durur: prerender'dan
    # sonra kabuk tek dosya değil (38 sayfa + spa-fallback) ve `try_files` iç
    # yönlendirmesi location'ı yeniden seçmediği için ayrı bir dosya-adı bloğu
    # geri düşüşle gelen istekleri hiç yakalamıyordu. `$uri.html` prerender
    # çıktısını 301 yönlendirmesi olmadan servis eder. Uzun gerekçe:
    # nginx.conf'taki not, docs/prerender-karari.md §6.
    location / {
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        # `$uri/index.html` kök isteği (`/`) için şart — gerekçe nginx.conf'ta.
        try_files $uri $uri.html $uri/index.html /spa-fallback.html /index.html;
    }
}
